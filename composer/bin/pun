#!/usr/bin/env php
<?php

// Composer shim for Pun: on first run, downloads the release binary matching this package's version and
// platform from GitHub Releases into vendor/bin/, then runs it with the same arguments.

const PUN_VERSION = '0.4.6'; // the workspace version (tests/composer.rs); Composer's bin proxy loads no autoloader, so this alone picks the release

/** Pun's run error: the binary could not be fetched or started, so it exits 2 like `pun` itself. */
function pun_fail(string $message): never
{
    fwrite(STDERR, "pun: $message\n");
    exit(2);
}

function pun_target(): string
{
    $arch = match (strtolower(php_uname('m'))) {
        'x86_64', 'amd64' => 'x86_64',
        'arm64', 'aarch64' => 'aarch64',
        default => pun_fail('unsupported CPU architecture '.php_uname('m')),
    };

    return match (PHP_OS_FAMILY) {
        'Darwin' => "$arch-apple-darwin",
        'Linux' => "$arch-unknown-linux-musl", // static, so it runs on glibc and Alpine alike
        default => pun_fail('unsupported OS '.PHP_OS_FAMILY.' (Pun ships Linux and macOS binaries)'),
    };
}

function pun_download(string $url): string
{
    if (! ini_get('allow_url_fopen')) {
        pun_fail("download failed: $url (allow_url_fopen is off in php.ini)");
    }
    $http = ['user_agent' => 'shipfastlabs/pun composer shim', 'follow_location' => 1, 'timeout' => 120];
    // PHP's streams ignore the proxy variables that curl and Composer honour.
    $proxy = getenv('HTTPS_PROXY') ?: getenv('https_proxy');
    if ($proxy) {
        $http['proxy'] = preg_replace('#^https?://#', 'tcp://', $proxy);
        $http['request_fulluri'] = true;
    }
    $data = @file_get_contents($url, false, stream_context_create(['http' => $http]));
    if ($data === false) {
        // The last status line (after redirects), or PHP's own reason when there was no response.
        $status = array_values(array_filter($http_response_header ?? [], fn ($h) => str_starts_with($h, 'HTTP/')));
        $reason = end($status) ?: (error_get_last()['message'] ?? 'no response');
        pun_fail("download failed: $url ($reason)");
    }

    return $data;
}

/** The exit code of a command run without a shell, its output discarded; -1 when it cannot start. */
function pun_exec(array $command): int
{
    $null = ['file', '/dev/null', 'w'];
    $process = @proc_open($command, [['file', '/dev/null', 'r'], $null, $null], $pipes);

    return is_resource($process) ? proc_close($process) : -1;
}

/**
 * GitHub's build attestation: proof the archive came from Pun's release workflow for this tag on a GitHub-hosted
 * runner, which the checksum (published beside the archive) cannot give. Like docs/public/install and
 * `pun self-update`, it needs a signed-in gh, so without one it is skipped unless PUN_REQUIRE_ATTESTATION=1.
 */
function pun_attest(string $file, string $archive, string $version): void
{
    if (pun_exec(['gh', 'auth', 'status']) !== 0) {
        if (getenv('PUN_REQUIRE_ATTESTATION') === '1') {
            pun_fail('PUN_REQUIRE_ATTESTATION=1 needs the GitHub CLI (gh), signed in');
        }

        return;
    }
    $verify = pun_exec([
        'gh', 'attestation', 'verify', $file, '--repo', 'shipfastlabs/pun',
        '--signer-workflow', 'github.com/shipfastlabs/pun/.github/workflows/release.yml',
        '--source-ref', "refs/tags/v$version", '--deny-self-hosted-runners',
    ]);
    if ($verify !== 0) {
        pun_fail("the build attestation of $archive does not verify; the download may have been tampered with");
    }
    fwrite(STDERR, "pun: verified the GitHub build attestation\n");
}

/**
 * Whether $file is a native executable, not a link or a script. Every package's bins share vendor/bin, and Composer
 * fills it only with script proxies, so a dependency that claims Pun's binary name is downloaded over.
 */
function pun_native(string $file): bool
{
    if (is_link($file) || ! is_file($file)) {
        return false;
    }
    $magic = (string) @file_get_contents($file, false, null, 0, 4);

    return $magic === "\x7fELF" || $magic === "\xcf\xfa\xed\xfe" || $magic === "\xca\xfe\xba\xbe";
}

/** Removes the shim's temporary directory: PHP's own calls, not a command a bin in PATH could stand in for. */
function pun_remove(string $path): void
{
    if (is_dir($path) && ! is_link($path)) {
        foreach (scandir($path) ?: [] as $entry) {
            if ($entry !== '.' && $entry !== '..') {
                pun_remove("$path/$entry");
            }
        }
        @rmdir($path);
    } else {
        @unlink($path);
    }
}

$version = PUN_VERSION;
$target = pun_target();
$binDir = $GLOBALS['_composer_bin_dir'] ?? __DIR__;
// Named by platform too: a project shared between a Mac and its Linux container needs one binary for each.
$binary = "$binDir/pun-$version-$target";

if (! pun_native($binary)) {
    // Composer scripts put the bin directory first in PATH, where a dependency's bin could answer for gh or tar.
    $path = getenv('PATH');
    $real = realpath($binDir);
    $dirs = array_filter(explode(PATH_SEPARATOR, (string) $path), fn ($d) => $d !== '' && realpath($d) !== $real);
    putenv('PATH='.implode(PATH_SEPARATOR, $dirs));
    $archive = "punphp-$target.tar.gz";
    // Pun's tests serve the release from a local server.
    $github = getenv('PUN_GITHUB_URL') ?: 'https://github.com';
    $url = "$github/shipfastlabs/pun/releases/download/v$version/$archive";
    fwrite(STDERR, "pun: downloading $url\n");
    $data = pun_download($url);
    $expected = strtok(pun_download("$url.sha256"), " \n");
    if (! hash_equals($expected, hash('sha256', $data))) {
        pun_fail("checksum mismatch for $archive");
    }

    // Extracted next to the binary, so the final rename stays on one filesystem and no run sees half a file.
    $tmp = "$binDir/.pun-".bin2hex(random_bytes(8));
    if (! @mkdir($tmp, 0700, true)) {
        pun_fail("could not write to $binDir");
    }
    register_shutdown_function(fn () => pun_remove($tmp));
    file_put_contents("$tmp/$archive", $data);
    pun_attest("$tmp/$archive", $archive, $version);
    exec('tar xzf '.escapeshellarg("$tmp/$archive").' -C '.escapeshellarg($tmp).' 2>&1', $_, $code);
    $found = glob("$tmp/*/pun") ?: glob("$tmp/pun");
    if ($code !== 0 || ! $found || is_link($found[0])) {
        pun_fail("could not extract pun from $archive");
    }
    chmod($found[0], 0755);
    rename($found[0], $binary) || pun_fail("could not write $binary");
    $path === false ? putenv('PATH') : putenv("PATH=$path");
}

$process = @proc_open([$binary, ...array_slice($argv, 1)], [STDIN, STDOUT, STDERR], $pipes);
if (! is_resource($process)) {
    pun_fail("could not start $binary; delete it to download it again");
}
exit(proc_close($process));
